# Backend environment variables for SocialGram

# App
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT
JWT_SECRET=replace-with-a-long-random-secret

# PII Encryption (AWS KMS)
# ARN of the KMS key used to encrypt sensitive fields (e.g., emails)
# Provided by ops for this environment
PII_ENCRYPTION_KEY_ID=arn:aws:kms:ap-south-1:497863501987:key/110b05a9-ef94-45d8-b8a5-1c63d7307bf3
# Region for the above key
PII_KMS_REGION=ap-south-1
# Local mode avoids real AWS KMS calls (use true only for local dev/testing)
PII_ENCRYPTION_LOCAL_MODE=false

# Envelope encryption (DEK via KMS)
# In production: store only the KMS-encrypted data key (base64) in a secret manager
# Set this value from KMS GenerateDataKey -> CiphertextBlob (base64)
# Example (do not use real value here):
# PII_DATA_KEY_CIPHERTEXT_B64=base64-encoded-kms-encrypted-dek

# Optional: if you used an EncryptionContext when generating the DEK, provide it here as JSON
# PII_DATA_KEY_ENC_CONTEXT_JSON={"scope":"pii","table":"users"}

# Optional: log one-time KMS unwrap at startup (no secrets printed)
# PII_ENVELOPE_DEBUG=true

# In local/dev: optionally provide a plaintext 32-byte key (base64) to avoid real KMS
# If omitted in local, a deterministic dev key is used automatically
# Example (do not use in production):
# PII_DATA_KEY_PLAINTEXT_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Cloudinary (Phase 2)
# If uploading directly from frontend, you only need the following there:
#   VITE_CLOUDINARY_CLOUD_NAME, VITE_CLOUDINARY_UPLOAD_PRESET
# If you later switch to signed uploads from backend, add these and a signing endpoint:
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
